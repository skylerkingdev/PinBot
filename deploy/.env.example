# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit or share .env.

# Database password: any long random string (letters and digits only, to keep the connection string simple)
POSTGRES_PASSWORD=

# Optional admin API for scripts, LAN only (docs/SERVER.md): a long random string turns it on; leave empty for off
PINBOT_ADMIN_TOKEN=

# Tailscale auth key: admin console -> Settings -> Keys -> Generate auth key, with Reusable, Ephemeral and Tags all off
# (an ephemeral device disappears when the host reboots; a tagged one may not use Funnel)
TS_AUTHKEY=

# Updates (optional). stable (default): a release is installed once it has been out 48 hours. early: at once (the
# maintainer's own server).
PINBOT_UPDATE_RING=

# --- Discord - see docs/DISCORD-SETUP.md ---
PINBOT_PUBLIC_URL=https://pinbot.<your-tailnet>.ts.net
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# optional: separate channel for the weekly competition (defaults to DISCORD_CHANNEL_ID)
DISCORD_WEEKLY_CHANNEL_ID=

